# Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Supabase Configuration
# Get your project URL and anon key from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Sentry Configuration (Optional)
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
SENTRY_DSN=your_sentry_dsn_here

# Logging Configuration (Optional)
# Options: debug, info, warning, error
LOG_LEVEL=info

# Firebase Configuration (Optional)
# Get your API key from Firebase Console
FIREBASE_API_KEY=your_firebase_api_key_here
